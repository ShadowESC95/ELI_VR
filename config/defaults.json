{
  "schema_version": 1,
  "app": {
    "name": "ELI VR",
    "standalone": true
  },
  "xr": {
    "mode": "auto",
    "render_scale": 1.0,
    "snap_turn_degrees": 30,
    "smooth_locomotion": true,
    "move_speed": 2.0,
    "turn_cooldown_seconds": 0.3,
    "foveation": "auto",
    "pause_when_unfocused": true,
    "fly_speed": 5.0,
    "boost_multiplier": 2.4,
    "controller_calibration": {
      "frame": {
        "offset_m": [0.0, 0.0, 0.0],
        "yaw_deg": 0.0
      },
      "aim": {
        "left": [0.0, 0.0, -1.0],
        "right": [0.0, 0.0, -1.0]
      }
    },
    "universal_flight": true
  },
  "graphics": {
    "quality": "auto",
    "shadows": true,
    "fog": true,
    "particles": true,
    "world_detail_scale": 1.0,
    "auto_quality": true,
    "dynamic_resolution": true,
    "minimum_render_scale": 0.65,
    "maximum_render_scale": 1.1,
    "target_fps_ratio": 0.92
  },
  "world": {
    "room": "core_room",
    "environment_override": "",
    "theme": "frontier",
    "portals": true,
    "spatial_console": true,
    "object_manipulation": true
  },
  "desktop": {
    "enabled": true,
    "bridge_host": "127.0.0.1",
    "bridge_port": 47831,
    "display_mode": "auto",
    "distance_m": 0.0,
    "scale": 1.0,
    "curve": 1.0,
    "yaw_deg": 0.0,
    "lift_deg": 0.0,
    "layout_version": 3
  },
  "ui": {
    "desktop_dock": true,
    "readouts": {
      "fps": false,
      "controllers": false,
      "input": false,
      "status": false
    },
    "console_distance_m": 2.7,
    "wrist_menu": true
  },
  "eli_bridge": {
    "enabled": "auto",
    "endpoint": "http://127.0.0.1:8081",
    "token_env": "ELI_VR_TOKEN",
    "voice": true,
    "microphone": "",
    "model": ""
  },
  "audio": {
    "enabled": true,
    "ambient_volume_db": -18.0
  },
  "network": {
    "mode": "local_only",
    "allow_loopback": true,
    "allow_remote": false,
    "telemetry": false,
    "analytics": false,
    "sign_in": false,
    "cloud_sync": false,
    "auto_update": false,
    "remote_asset_downloads": false
  }
}
