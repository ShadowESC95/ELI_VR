    "form": {"shape": "str", "colour": "str", "size": "number", "glow": "number", "pos": "array<number>"},
    "claim_object": {"id": "str", "name": "str", "kind": "str", "room": "str", "x": "number", "y": "number",
                     "importance": "number", "meaning": "str", "made_by": "str", "claim": "claim", "form": "form"},
    "claim": {"relation": "str", "value": "str", "chance": "number", "sure": "number", "since": "number|null",
              "until": "number|null", "learned": "number|null", "origin": "str", "basis": "str", "confirmations": "int",
              "contested": "bool", "status": "str", "sources": "array<claim_source>"},
    "claim_source": {"id": "str", "kind": "str", "text": "str", "when": "number|null", "origin": "str"},
    "conflict_object": {"id": "str", "name": "str", "kind": "str", "room": "str", "x": "number", "y": "number",
                        "importance": "number", "relation": "str", "meaning": "str", "made_by": "str", "form": "form"},
    "memory_object": {"id": "str", "name": "str", "kind": "str", "room": "str", "x": "number", "y": "number",
