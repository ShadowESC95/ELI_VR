; ELI VR
; Godot 4.7.2-stable target.
config_version=5

[application]
config/name="ELI VR"
config/version="0.9.0"
config/description="Standalone cross-platform spatial workspace prototype"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[audio]
driver/enable_input=true

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.01, 0.015, 0.025, 1)

[xr]
openxr/enabled=true
openxr/startup_alert=false
openxr/default_action_map="res://openxr_action_map.tres"
openxr/reference_space=2
openxr/foveation_level=0
openxr/foveation_dynamic=false
shaders/enabled=true

[xr/openxr/extensions]
hand_tracking=false
hand_interaction_profile=false

